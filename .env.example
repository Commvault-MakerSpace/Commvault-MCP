# Copy to ~/.config/cv-mcp/lab.env (chmod 600) or another file outside the repo and
# start the server with `uv run --env-file <path> cv-mcp serve`.

# Command Center base URL (no trailing path). https://host or https://ip
CV_SERVER_URL=https://commvaultlab.example.com

# Access token + refresh token created under Profile > Access tokens in Command Center.
# The refresh token is single-use; the server rotates both after a renew.
CV_ACCESS_TOKEN=
CV_REFRESH_TOKEN=

# Optional: JSON file where rotated tokens are persisted (recommended so renewals survive restarts).
# If unset, rotated tokens live in memory only and are lost on restart.
CV_TOKEN_FILE=~/.config/cv-mcp/tokens.json

# TLS: set to false only for labs with self-signed certs, or point CV_CA_BUNDLE at the exported cert.
CV_SSL_VERIFY=true
CV_CA_BUNDLE=

# Optional: local IP to bind outgoing connections to (e.g. a VPN adapter address).
CV_LOCAL_ADDRESS=

# Register tools with side effects (suspend/kill jobs, run backups, enable/disable schedules ...).
CV_MCP_ALLOW_WRITES=false

# Logging goes to stderr; DEBUG logs request paths and response sizes, never tokens.
CV_LOG_LEVEL=INFO
